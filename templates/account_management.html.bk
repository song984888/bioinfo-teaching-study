{% extends "base.html" %}

{% block title %}学生管理{% endblock %}

{% block content %}

<div class="container">
    <h1>学生管理</h1>
    
    <!-- 用户统计卡片 -->
    <div class="stats">
        <div class="stat-card">
            <h3>注册用户总数</h3>
            <p>{{ total_users }}</p>
        </div>
        <div class="stat-card">
            <h3>学生账户数</h3>
            <p>{{ student_count }}</p>
        </div>
    </div>

    <!-- 功能区域 -->
    <div class="features">
        <!-- 账户注册 -->
        <div class="feature-card">
            <h3>👤 账户注册</h3>
            <form action="/register" method="POST">
                <input type="text" name="name" placeholder="姓名" required>
                <input type="text" name="employee_id" placeholder="学号" required>
                <input type="password" name="password" placeholder="密码" required> 
                <select name="role">
                    <option value="student">学生</option>
                    <option value="assistant">助教</option>
                </select>
                <button type="submit">创建账户</button>
            </form>
        </div>
        
        <!-- 登录权限管理 -->
        <div class="feature-card">
            <h3>🔑 登录权限管理</h3>
            <table>
                <thead>
                    <tr>
                        <th>姓名</th>
                        <th>学号</th>
                        <th>角色</th>
                        <th>登录状态</th>
                        <th>操作</th>
                        <th>学习详情</th>  <!-- 新增列 -->
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td>{{ user.name }}</td>
                        <td>{{ user.employee_id }}</td>
                        <td>{{ user.role }}</td>
                        <td>{{ "允许登录" if user.can_login else "禁止登录" }}</td>
                        <td>
                            <a href="/toggle_login/{{ user.id }}">
                                {{ "禁用" if user.can_login else "启用" }}
                            </a>
                        </td>
                        <td>
                            <a href="/study_detailed/{{ user.employee_id }}" class="study-detail-link">
                                查看详情
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 学习详情模态框 -->
<div id="studyModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h2>用户学习详情</h2>
        <div class="tabs">
            <button class="tab-link active" data-tab="exercise">练习数据</button>
            <button class="tab-link" data-tab="exam">考试数据</button>
            <button class="tab-link" data-tab="suggestion">学习建议</button>
        </div>
        
        <div id="exercise" class="tab-content active">
            <table class="study-table">
                <thead>
                    <tr>
                        <th>总练习数</th>
                        <th>首次练习日期</th>
                        <th>最后练习日期</th>
                        <th>热门主题</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td id="total-exercises">-</td>
                        <td id="first-exercise-date">-</td>
                        <td id="last-exercise-date">-</td>
                        <td id="hot-topic">-</td>
                    </tr>
                </tbody>
            </table>
            <h4>分布情况</h4>
            <div class="distribution">
                <div class="dist-chart">
                    <h5>主题分布</h5>
                    <div id="topics-distribution">暂无数据</div>
                </div>
                <div class="dist-chart">
                    <h5>难度分布</h5>
                    <div id="difficulty-distribution">暂无数据</div>
                </div>
                <div class="dist-chart">
                    <h5>语言分布</h5>
                    <div id="language-distribution">暂无数据</div>
                </div>
            </div>
        </div>
        
        <div id="exam" class="tab-content">
            <table class="study-table">
                <thead>
                    <tr>
                        <th>总考试数</th>
                        <th>平均AI评分</th>
                        <th>平均教师评分</th>
                        <th>平均分数差异</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td id="total-exams">-</td>
                        <td id="avg-ai-score">-</td>
                        <td id="avg-teacher-score">-</td>
                        <td id="avg-score-difference">-</td>
                    </tr>
                </tbody>
            </table>
            <h4>考试分析</h4>
            <div class="exam-analysis">
                <div class="analysis-item">
                    <h5>常见AI反馈</h5>
                    <div id="common-ai-feedback">暂无数据</div>
                </div>
                <div class="analysis-item">
                    <h5>常见教师反馈</h5>
                    <div id="common-teacher-feedback">暂无数据</div>
                </div>
                <div class="analysis-item">
                    <h5>分数趋势</h5>
                    <div id="score-trend">暂无数据</div>
                </div>
            </div>
        </div>
        
        <div id="suggestion" class="tab-content">
            <div class="suggestion-content">
                <h4>个性化学习建议</h4>
                <div id="study-suggestion">暂无学习建议</div>
                <p class="suggestion-date">生成时间: <span id="suggestion-date">-</span></p>
            </div>
        </div>
    </div>
</div>

<style>
.study-detail-link {
    color: #1a73e8;
    text-decoration: none;
}
.study-detail-link:hover {
    text-decoration: underline;
}

/* 模态框样式 */
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.5);
}

.modal-content {
    background-color: #fefefe;
    margin: 5% auto;
    padding: 20px;
    border: 1px solid #888;
    width: 80%;
    max-width: 900px;
    border-radius: 8px;
    position: relative;
}

.close {
    color: #aaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
    position: absolute;
    right: 20px;
    top: 10px;
}

.close:hover {
    color: black;
}

/* 标签页样式 */
.tabs {
    display: flex;
    border-bottom: 1px solid #ccc;
    margin-bottom: 20px;
}

.tab-link {
    padding: 10px 20px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    border-bottom: 3px solid transparent;
}

.tab-link.active {
    border-bottom: 3px solid #1a73e8;
    color: #1a73e8;
}

.tab-content {
    display: none;
}

.tab-content.active {
    display: block;
}

/* 表格样式 */
.study-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
}

.study-table th, .study-table td {
    border: 1px solid #ddd;
    padding: 10px;
    text-align: center;
}

.study-table th {
    background-color: #f5f5f5;
}

/* 分布图表样式 */
.distribution, .exam-analysis {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 20px;
}

.dist-chart, .analysis-item {
    flex: 1;
    min-width: 200px;
    border: 1px solid #ddd;
    padding: 15px;
    border-radius: 5px;
    background-color: #f9f9f9;
}

.dist-chart h5, .analysis-item h5 {
    margin-top: 0;
    border-bottom: 1px solid #eee;
    padding-bottom: 8px;
}

/* 学习建议样式 */
.suggestion-content {
    padding: 15px;
    background-color: #f9f9f9;
    border-radius: 5px;
}

.suggestion-date {
    text-align: right;
    font-style: italic;
    color: #666;
}
</style>

<script>
// 模态框控制
document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('studyModal');
    const closeBtn = document.querySelector('.close');
    const studyLinks = document.querySelectorAll('.study-detail-link');
    const tabLinks = document.querySelectorAll('.tab-link');
    
    // 关闭模态框
    closeBtn.onclick = function() {
        modal.style.display = 'none';
    }
    
    // 点击模态框外部关闭
    window.onclick = function(event) {
        if (event.target == modal) {
            modal.style.display = 'none';
        }
    }
    
    // 点击学习详情链接
    studyLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const userId = this.getAttribute('href').split('/').pop();
            loadStudyData(userId);
            modal.style.display = 'block';
        });
    });
    
    // 标签页切换
    tabLinks.forEach(tab => {
        tab.addEventListener('click', function() {
            const tabName = this.getAttribute('data-tab');
            
            // 移除所有active类
            tabLinks.forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));
            
            // 添加active类到当前标签
            this.classList.add('active');
            document.getElementById(tabName).classList.add('active');
        });
    });
});

// 加载学习数据
function loadStudyData(userId) {
    fetch(`/api/study_data/${userId}`)
        .then(response => response.json())
        .then(data => {
            // 填充练习数据
            if (data.exercise) {
                document.getElementById('total-exercises').textContent = data.exercise.total_exercises || '-';
                document.getElementById('first-exercise-date').textContent = data.exercise.first_exercise_date || '-';
                document.getElementById('last-exercise-date').textContent = data.exercise.last_exercise_date || '-';
                document.getElementById('hot-topic').textContent = data.exercise.hot_topic || '-';
                
                // 填充分布数据（这里简化处理，实际应使用图表库）
                if (data.exercise.topics_distribution) {
                    document.getElementById('topics-distribution').textContent = 
                        JSON.stringify(data.exercise.topics_distribution);
                }
                if (data.exercise.difficulty_distribution) {
                    document.getElementById('difficulty-distribution').textContent = 
                        JSON.stringify(data.exercise.difficulty_distribution);
                }
                if (data.exercise.language_distribution) {
                    document.getElementById('language-distribution').textContent = 
                        JSON.stringify(data.exercise.language_distribution);
                }
            }
            
            // 填充考试数据
            if (data.exam) {
                document.getElementById('total-exams').textContent = data.exam.total_exams || '-';
                document.getElementById('avg-ai-score').textContent = data.exam.avg_ai_score || '-';
                document.getElementById('avg-teacher-score').textContent = data.exam.avg_teacher_score || '-';
                document.getElementById('avg-score-difference').textContent = data.exam.avg_score_difference || '-';
                
                // 填充分析数据
                if (data.exam.common_ai_feedback) {
                    document.getElementById('common-ai-feedback').textContent = 
                        data.exam.common_ai_feedback;
                }
                if (data.exam.common_teacher_feedback) {
                    document.getElementById('common-teacher-feedback').textContent = 
                        data.exam.common_teacher_feedback;
                }
                if (data.exam.score_trend) {
                    document.getElementById('score-trend').textContent = 
                        JSON.stringify(data.exam.score_trend);
                }
            }
            
            // 填充学习建议
            if (data.suggestion) {
                document.getElementById('study-suggestion').textContent = 
                    data.suggestion.study_suggestion || '暂无学习建议';
                document.getElementById('suggestion-date').textContent = 
                    data.suggestion.created_at || '-';
            }
        })
        .catch(error => {
            console.error('Error loading study data:', error);
        });
}
</script>

{% endblock %}
