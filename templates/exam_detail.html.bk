
{% extends "base.html" %}
{% block title %}考试{% endblock %}
{% block content %}


    <div class="container">
        <!-- 头部导航保持不变 -->
        
        <div class="page-title">
            <h2><i class="fas fa-file-alt"></i> 考试详情</h2>
        </div>
        
        <div class="exam-detail">
            <div class="detail-header">
                <h3>{{ exam.topic }}</h3>
                <p>提交时间: {{ exam.submitted_at.strftime('%Y-%m-%d %H:%M') }}</p>
            </div>
            
            <div class="scores-section">
                <div class="score-card">
                    <h4>AI评分</h4>
                    <div class="score-value">{{ exam.ai_score }}<span>/100</span></div>
                    <div class="score-comment">{{ exam.ai_comment }}</div>
                </div>
                
                {% if exam.is_reviewed %}
                <div class="score-card">
                    <h4>教师评分</h4>
                    <div class="score-value">{{ exam.teacher_score }}<span>/100</span></div>
                    <div class="score-comment">{{ exam.teacher_comment }}</div>
                </div>
                {% endif %}
            </div>
            
            <div class="question-section">
                <h4><i class="fas fa-question-circle"></i> 题目要求</h4>
                <div class="question-content">
                    {{ exam.question_text|safe }}
                </div>
            </div>
            
            <div class="answer-section">
                <h4><i class="fas fa-code"></i> 你的答案</h4>
                <pre><code>{{ exam.student_answer }}</code></pre>
            </div>
            
            {% if exam.sample_answer %}
            <div class="reference-section">
                <h4><i class="fas fa-lightbulb"></i> 参考答案</h4>
                <pre><code>{{ exam.sample_answer }}</code></pre>
            </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
