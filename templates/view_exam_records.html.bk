{% extends "base.html" %}

{% block title %}考试记录管理{% endblock %}

{% block content %}
<div class="exam-records-container">
    <div class="page-header">
        <h2>考试记录管理</h2>
    </div>

    <!-- 筛选表单 -->
    <div class="filter-section">
        <form method="GET" action="{{ url_for('view_exam_records') }}" class="filter-form">
            <div class="filter-row">
                <div class="filter-group">
                    <label for="student_name">学生姓名:</label>
                    <input type="text" id="student_name" name="student_name" 
                           value="{{ request_args.get('student_name', '') }}" 
                           placeholder="输入学生姓名">
                </div>
                
                <div class="filter-group">
                    <label for="student_id">学号:</label>
                    <input type="text" id="student_id" name="student_id" 
                           value="{{ request_args.get('student_id', '') }}" 
                           placeholder="输入学号">
                </div>
                
                <div class="filter-group">
                    <label for="start_date">起始日期:</label>
                    <input type="date" id="start_date" name="start_date" 
                           value="{{ request_args.get('start_date', '') }}">
                </div>
                
                <div class="filter-group">
                    <label for="end_date">结束日期:</label>
                    <input type="date" id="end_date" name="end_date" 
                           value="{{ request_args.get('end_date', '') }}">
                </div>
            </div>
            
            <div class="filter-row">
                <div class="filter-group">
                    <label for="topic">主题:</label>
                    <select id="topic" name="topic">
                        <option value="">所有主题</option>
                        {% for topic in all_topics %}
                        <option value="{{ topic }}" {% if request_args.get('topic') == topic %}selected{% endif %}>
                            {{ topic }}
                        </option>
                        {% endfor %}
                    </select>
                </div>
                
                <div class="filter-group">
                    <label for="difficulty">难度:</label>
                    <select id="difficulty" name="difficulty">
                        <option value="">所有难度</option>
                        <option value="1" {% if request_args.get('difficulty') == '1' %}selected{% endif %}>1星</option>
                        <option value="2" {% if request_args.get('difficulty') == '2' %}selected{% endif %}>2星</option>
                        <option value="3" {% if request_args.get('difficulty') == '3' %}selected{% endif %}>3星</option>
                    </select>
                </div>
                
                <div class="filter-group">
                    <label for="language">语言:</label>
                    <select id="language" name="language">
                        <option value="">所有语言</option>
                        {% for lang in all_languages %}
                        <option value="{{ lang }}" {% if request_args.get('language') == lang %}selected{% endif %}>
                            {{ lang|upper }}
                        </option>
                        {% endfor %}
                    </select>
                </div>
                
                <div class="filter-group">
                    <label for="review_status">评阅状态:</label>
                    <select id="review_status" name="review_status">
                        <option value="">全部</option>
                        <option value="reviewed" {% if request_args.get('review_status') == 'reviewed' %}selected{% endif %}>已评阅</option>
                        <option value="not_reviewed" {% if request_args.get('review_status') == 'not_reviewed' %}selected{% endif %}>未评阅</option>
                    </select>
                </div>
                
                <div class="filter-actions">
                    <button type="submit" class="btn primary">应用筛选</button>
                    <a href="{{ url_for('view_exam_records') }}" class="btn">清除筛选</a>
                </div>
            </div>
        </form>
    </div>

    <!-- 显示当前筛选条件 -->
    {% if request_args %}
    <div class="active-filters">
        <span>当前筛选: </span>
        {% if request_args.get('student_name') %}
        <span class="filter-tag">学生姓名: {{ request_args.get('student_name') }}</span>
        {% endif %}
        {% if request_args.get('student_id') %}
        <span class="filter-tag">学号: {{ request_args.get('student_id') }}</span>
        {% endif %}
        {% if request_args.get('start_date') %}
        <span class="filter-tag">起始日期: {{ request_args.get('start_date') }}</span>
        {% endif %}
        {% if request_args.get('end_date') %}
        <span class="filter-tag">结束日期: {{ request_args.get('end_date') }}</span>
        {% endif %}
        {% if request_args.get('topic') %}
        <span class="filter-tag">主题: {{ request_args.get('topic') }}</span>
        {% endif %}
        {% if request_args.get('difficulty') %}
        <span class="filter-tag">难度: {{ request_args.get('difficulty') }}星</span>
        {% endif %}
        {% if request_args.get('language') %}
        <span class="filter-tag">语言: {{ request_args.get('language')|upper }}</span>
        {% endif %}
        {% if request_args.get('review_status') %}
        <span class="filter-tag">评阅状态: {{ '已评阅' if request_args.get('review_status') == 'reviewed' else '未评阅' }}</span>
        {% endif %}
    </div>
    {% endif %}

    <!-- 显示结果计数 -->
    <div class="results-count">
        找到 {{ records|length }} 条考试记录
    </div>

    {% if not records %}
        <div class="empty-state">
            <p>没有找到符合条件的考试记录</p>
        </div>
    {% else %}
        <div class="records-table-container">
            <table class="records-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>学生信息</th>
                        <th>题目主题</th>
                        <th>难度</th>
                        <th>语言</th>
                        <th>提交时间</th>
                        <th>AI评分</th>
                        <th>教师评分</th>
                        <th>评阅状态</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    {% for record in records %}
                    <tr>
                        <td>{{ record.id }}</td>
                        <td>
                            <div class="student-info">
                                <div class="student-name">{{ record.student_name }}</div>
                                <div class="student-id">{{ record.student_id }}</div>
                            </div>
                        </td>
                        <td>{{ record.topic }}</td>
                        <td>
                            {% for i in range(1,4) %}
                                {% if i <= record.difficulty %}
                                ★
                                {% else %}
                                ☆
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>{{ record.language|upper }}</td>
                        <td>{{ record.submitted_at.strftime('%Y-%m-%d %H:%M') }}</td>
                        <td>
                            {% if record.ai_score is not none %}
                            <span class="score-badge">{{ record.ai_score }}</span>
                            {% else %}
                            <span class="na-badge">N/A</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if record.teacher_score is not none %}
                            <span class="score-badge">{{ record.teacher_score }}</span>
                            {% else %}
                            <span class="na-badge">N/A</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if record.is_reviewed %}
                            <span class="status-badge status-reviewed">已评阅</span>
                            {% else %}
                            <span class="status-badge status-pending">待评阅</span>
                            {% endif %}
                        </td>
                        <td class="actions">
                            <button class="btn small review-btn" data-exam-id="{{ record.id }}">
                                评阅
                            </button>
                            <button class="btn small view-btn" data-exam-id="{{ record.id }}">
                                详情
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<!-- 评阅模态框 -->
<div id="reviewModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>考试评阅</h3>
            <span class="close">&times;</span>
        </div>
        <div class="modal-body">
            <form id="reviewForm">
                <input type="hidden" id="examId" name="exam_id">
                
                <div class="form-group">
                    <label for="questionText">题目内容:</label>
                    <div id="questionText" class="readonly-field"></div>
                </div>
                
                <div class="form-group">
                    <label for="studentAnswer">学生答案:</label>
                    <pre id="studentAnswer" class="readonly-field"></pre>
                </div>
                
                <div class="form-group">
                    <label for="aiScore">AI评分:</label>
                    <div id="aiScore" class="readonly-field"></div>
                </div>
                
                <div class="form-group">
                    <label for="aiComment">AI评语:</label>
                    <div id="aiComment" class="readonly-field"></div>
                </div>
                
                <div class="form-group">
                    <label for="teacherScore">教师评分 *</label>
                    <input type="number" id="teacherScore" name="teacher_score" min="0" max="100" required>
                </div>
                
                <div class="form-group">
                    <label for="teacherComment">教师评语</label>
                    <textarea id="teacherComment" name="teacher_comment" rows="4" placeholder="请输入评语..."></textarea>
                </div>
                
                <div class="form-actions">
                    <button type="submit" class="btn primary">提交评分</button>
                    <button type="button" class="btn cancel">取消</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.exam-records-container {
    padding: 20px;
}

.page-header {
    margin-bottom: 20px;
}

.filter-section {
    background-color: #f8f9fa;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 20px;
}

.filter-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    align-items: end;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 150px;
}

.filter-group label {
    font-weight: 500;
    font-size: 14px;
    color: #495057;
}

.filter-group select,
.filter-group input {
    padding: 8px 12px;
    border: 1px solid #ced4da;
    border-radius: 4px;
    font-size: 14px;
}

.filter-actions {
    display: flex;
    gap: 10px;
    margin-left: auto;
}

.active-filters {
    margin-bottom: 15px;
    padding: 10px;
    background-color: #e9ecef;
    border-radius: 4px;
}

.filter-tag {
    display: inline-block;
    padding: 4px 8px;
    margin: 0 5px;
    background-color: #007bff;
    color: white;
    border-radius: 12px;
    font-size: 12px;
}

.results-count {
    margin-bottom: 15px;
    font-weight: 500;
    color: #495057;
}

.records-table-container {
    overflow-x: auto;
}

.records-table {
    width: 100%;
    border-collapse: collapse;
}

.records-table th,
.records-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #dee2e6;
}

.records-table th {
    background-color: #f8f9fa;
    font-weight: 600;
    position: sticky;
    top: 0;
}

.student-info .student-name {
    font-weight: 500;
}

.student-info .student-id {
    font-size: 12px;
    color: #6c757d;
}

.score-badge {
    display: inline-block;
    padding: 4px 8px;
    background-color: #28a745;
    color: white;
    border-radius: 4px;
    font-weight: 500;
}

.na-badge {
    display: inline-block;
    padding: 4px 8px;
    background-color: #6c757d;
    color: white;
    border-radius: 4px;
    font-size: 12px;
}

.status-badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
}

.status-reviewed {
    background-color: #d4edda;
    color: #155724;
}

.status-pending {
    background-color: #fff3cd;
    color: #856404;
}

.actions {
    display: flex;
    gap: 5px;
}

.btn {
    display: inline-block;
    padding: 6px 12px;
    background-color: #6c757d;
    color: white;
    text-decoration: none;
    border-radius: 4px;
    font-size: 14px;
    border: none;
    cursor: pointer;
}

.btn.small {
    padding: 4px 8px;
    font-size: 12px;
}

.btn.primary {
    background-color: #007bff;
}

.btn.danger {
    background-color: #dc3545;
}

.btn:hover {
    opacity: 0.9;
}

.empty-state {
    text-align: center;
    padding: 40px;
    color: #6c757d;
    background-color: #f8f9fa;
    border-radius: 8px;
}

/* 模态框样式 */
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.5);
}

.modal-content {
    background-color: #fefefe;
    margin: 5% auto;
    padding: 0;
    border: 1px solid #888;
    width: 80%;
    max-width: 800px;
    border-radius: 8px;
    box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2);
}

.modal-header {
    padding: 15px 20px;
    background-color: #f8f9fa;
    border-bottom: 1px solid #dee2e6;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header h3 {
    margin: 0;
}

.close {
    color: #aaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
}

.close:hover,
.close:focus {
    color: black;
    text-decoration: none;
}

.modal-body {
    padding: 20px;
}

.form-group {
    margin-bottom: 15px;
}

.form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: 500;
}

.readonly-field {
    padding: 10px;
    background-color: #f8f9fa;
    border-radius: 4px;
    border: 1px solid #ced4da;
    min-height: 20px;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid #ced4da;
    border-radius: 4px;
    font-size: 14px;
    box-sizing: border-box;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 20px;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 获取模态框元素
    const modal = document.getElementById('reviewModal');
    const closeBtn = document.querySelector('.close');
    const cancelBtn = document.querySelector('.cancel');
    const reviewForm = document.getElementById('reviewForm');
    
    // 打开模态框的函数
    function openReviewModal(examId) {
        // 获取考试详情
        fetch(`/teacher/get_exam_detail/${examId}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const exam = data.exam;
                    
                    // 填充模态框内容
                    document.getElementById('examId').value = exam.id;
                    document.getElementById('questionText').textContent = exam.question_text;
                    document.getElementById('studentAnswer').textContent = exam.student_answer;
                    document.getElementById('aiScore').textContent = exam.ai_score !== null ? exam.ai_score : 'N/A';
                    document.getElementById('aiComment').textContent = exam.ai_comment || '无评语';
                    document.getElementById('teacherScore').value = exam.teacher_score || '';
                    document.getElementById('teacherComment').value = exam.teacher_comment || '';
                    
                    // 显示模态框
                    modal.style.display = 'block';
                } else {
                    alert('获取考试详情失败: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('获取考试详情时发生错误');
            });
    }
    
    // 关闭模态框的函数
    function closeModal() {
        modal.style.display = 'none';
    }
    
    // 点击评阅按钮
    document.querySelectorAll('.review-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const examId = this.dataset.examId;
            openReviewModal(examId);
        });
    });
    
    // 点击关闭按钮
    closeBtn.addEventListener('click', closeModal);
    cancelBtn.addEventListener('click', closeModal);
    
    // 点击模态框外部关闭
    window.addEventListener('click', function(event) {
        if (event.target === modal) {
            closeModal();
        }
    });
    
    // 表单提交
    reviewForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        
        fetch("{{ url_for('update_exam_score') }}", {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('评分提交成功');
                closeModal();
                location.reload(); // 刷新页面更新状态
            } else {
                alert('评分提交失败: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('评分提交时发生错误');
        });
    });
    
    // 详情按钮点击事件（可根据需要实现）
    document.querySelectorAll('.view-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const examId = this.dataset.examId;
            // 可以跳转到详情页面或打开另一个模态框
            alert('查看详情功能: 考试记录 ID ' + examId);
        });
    });
});
</script>
{% endblock %}
