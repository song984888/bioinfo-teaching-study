{% extends "base.html" %}

{% block content %}
<div class="container py-5">
    <!-- 报告头部 -->
    <div class="report-header text-center mb-5">
        <h1 class="display-4 mb-3"><i class="fas fa-graduation-cap me-2"></i>个性化学习建议报告</h1>
        <p class="lead">基于您的学习历史数据定制的专属提升方案</p>
        <div class="report-meta d-flex justify-content-center mt-4">
            <div class="meta-item me-4">
                <i class="fas fa-user fa-lg me-2"></i>
                <span>{{ student.name }} | {{ student.employee_id }}</span>
            </div>
            <div class="meta-item me-4">
                <i class="fas fa-book fa-lg me-2"></i>
                <span>{{ student.course }} | {{ student.level }}阶段</span>
            </div>
            <div class="meta-item">
                <i class="fas fa-calendar-alt fa-lg me-2"></i>
                <span>{{ report_date }}</span>
            </div>
        </div>
    </div>

    <!-- 学习概览卡片 -->
    <div class="card shadow-lg mb-5">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0"><i class="fas fa-chart-line me-2"></i>学习概览</h2>
        </div>
        <div class="card-body">
            <div class="row">
                <!-- 学习指标 -->
                <div class="col-md-8">
                    <div class="row metrics">
                        <div class="col-md-4 mb-4">
                            <div class="metric-card text-center p-3">
                                <div class="metric-value display-5">{{ exam_metrics.total_exams }}</div>
                                <div class="metric-label">考试次数</div>
                                <div class="metric-trend text-success">
                                    <i class="fas fa-arrow-up me-1"></i>{{ exam_metrics.score_trend }}%
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="metric-card text-center p-3">
                                <div class="metric-value display-5">{{ exercise_metrics.total_exercises }}</div>
                                <div class="metric-label">练习次数</div>
                                <div class="metric-trend text-success">
                                    <i class="fas fa-arrow-up me-1"></i>{{ exam_metrics.login_trend }}%
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="metric-card text-center p-3">
                                <div class="metric-value display-5">{{ exam_metrics.completion_rate }}%</div>
                                <div class="metric-label">练习完成率</div>
                                <div class="metric-trend text-warning">
                                    <i class="fas fa-minus me-1"></i>稳定
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 学习时间分布 -->
                    <div class="time-distribution mt-4">
                        <h4 class="mb-3"><i class="fas fa-clock me-2 text-info"></i>学习时间分布</h4>
                        <div class="distribution-chart">
                            <div class="distribution-item mb-2">
                                <div class="d-flex justify-content-between mb-1">
                                    <span>早晨 (6-12点)</span>
                                    <span>{{ exercise_metrics.time_distribution.morning }}%</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar" role="progressbar" 
                                         style="width: {{ exercise_metrics.time_distribution.morning }}%; background-color: #4e73df;"></div>
                                </div>
                            </div>
                            <div class="distribution-item mb-2">
                                <div class="d-flex justify-content-between mb-1">
                                    <span>下午 (12-18点)</span>
                                    <span>{{ exercise_metrics.time_distribution.afternoon }}%</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar" role="progressbar" 
                                         style="width: {{ exercise_metrics.time_distribution.afternoon }}%; background-color: #1cc88a;"></div>
                                </div>
                            </div>
                            <div class="distribution-item mb-2">
                                <div class="d-flex justify-content-between mb-1">
                                    <span>晚上 (18-24点)</span>
                                    <span>{{ exercise_metrics.time_distribution.evening }}%</span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar" role="progressbar" 
                                         style="width: {{ exercise_metrics.time_distribution.evening }}%; background-color: #36b9cc;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- 学习状态摘要 -->
                <div class="col-md-4">
                    <div class="status-summary bg-light p-4 rounded">
                        <h4 class="mb-3"><i class="fas fa-sticky-note me-2 text-primary"></i>状态摘要</h4>
                        <p class="summary-text">{{ study_suggestion.split('📊')[1].split('🏆')[0]|trim }}</p>
                        
                        <div class="key-topics mt-4">
                            <h5><i class="fas fa-bookmark me-2 text-warning"></i>热门主题</h5>
                            <div class="d-flex flex-wrap mt-2">
                                {% for topic in exercise_metrics.hot_topic %}
                                <span class="badge bg-info me-2 mb-2">{{ topic }}</span>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 学习建议内容 -->
    <div class="card shadow-lg mb-5">
        <div class="card-header bg-success text-white">
            <h2 class="mb-0"><i class="fas fa-lightbulb me-2"></i>个性化学习建议</h2>
        </div>
        <div class="card-body">
            <div class="study-suggestion-content">
                <!-- 使用Marked.js动态渲染Markdown内容 -->
                <div id="suggestion-markdown" class="d-none">{{ study_suggestion }}</div>
                <div id="suggestion-content"></div>
            </div>
        </div>
    </div>

    <!-- 主题分析 -->
    <div class="row">
        <!-- 主题分布 -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-info text-white">
                    <h5><i class="fas fa-tags me-2"></i>主题分布</h5>
                </div>
                <div class="card-body">
                    <canvas id="topicChart"></canvas>
                </div>
            </div>
        </div>
        
        <!-- 难度分布 -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-warning text-dark">
                    <h5><i class="fas fa-chart-pie me-2"></i>难度分布</h5>
                </div>
                <div class="card-body">
                    <canvas id="difficultyChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 语言分布 -->
    <div class="card mb-5">
        <div class="card-header bg-purple text-white">
            <h5><i class="fas fa-code me-2"></i>语言分布</h5>
        </div>
        <div class="card-body">
            <canvas id="languageChart"></canvas>
        </div>
    </div>

    <!-- 操作按钮 -->
    <div class="text-center mt-5">
        <button class="btn btn-primary btn-lg me-3" onclick="downloadReport()">
            <i class="fas fa-download me-2"></i>下载完整报告
        </button>
        <button class="btn btn-success btn-lg me-3">
            <i class="fas fa-calendar-plus me-2"></i>添加到学习计划
        </button>
        <button class="btn btn-outline-secondary btn-lg" onclick="window.location.reload()">
            <i class="fas fa-redo me-2"></i>重新生成建议
        </button>
    </div>
</div>

<!-- 引入Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- 引入Marked.js用于渲染Markdown -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
// 页面加载完成后执行
document.addEventListener('DOMContentLoaded', function() {
    // 渲染Markdown内容
    const markdownContent = document.getElementById('suggestion-markdown').textContent;
    document.getElementById('suggestion-content').innerHTML = marked.parse(markdownContent);
    
    // 主题分布图表
    const topicCtx = document.getElementById('topicChart').getContext('2d');
    const topicChart = new Chart(topicCtx, {
        type: 'bar',
        data: {
            labels: Object.keys({{ exercise_metrics.topics_distribution|tojson }}),
            datasets: [{
                label: '练习次数',
                data: Object.values({{ exercise_metrics.topics_distribution|tojson }}),
                backgroundColor: [
                    'rgba(54, 162, 235, 0.5)',
                    'rgba(75, 192, 192, 0.5)',
                    'rgba(153, 102, 255, 0.5)',
                    'rgba(255, 159, 64, 0.5)',
                    'rgba(255, 99, 132, 0.5)'
                ],
                borderColor: [
                    'rgba(54, 162, 235, 1)',
                    'rgba(75, 192, 192, 1)',
                    'rgba(153, 102, 255, 1)',
                    'rgba(255, 159, 64, 1)',
                    'rgba(255, 99, 132, 1)'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                title: {
                    display: true,
                    text: '各主题练习次数分布'
                }
            }
        }
    });
    
    // 难度分布图表
    const difficultyCtx = document.getElementById('difficultyChart').getContext('2d');
    const difficultyChart = new Chart(difficultyCtx, {
        type: 'pie',
        data: {
            labels: Object.keys({{ exercise_metrics.difficulty_distribution|tojson }}),
            datasets: [{
                label: '难度分布',
                data: Object.values({{ exercise_metrics.difficulty_distribution|tojson }}),
                backgroundColor: [
                    'rgba(75, 192, 192, 0.5)',
                    'rgba(255, 206, 86, 0.5)',
                    'rgba(255, 99, 132, 0.5)'
                ],
                borderColor: [
                    'rgba(75, 192, 192, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(255, 99, 132, 1)'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'right',
                },
                title: {
                    display: true,
                    text: '练习难度分布'
                }
            }
        }
    });
    
    // 语言分布图表
    const languageCtx = document.getElementById('languageChart').getContext('2d');
    const languageChart = new Chart(languageCtx, {
        type: 'doughnut',
        data: {
            labels: Object.keys({{ exercise_metrics.language_distribution|tojson }}),
            datasets: [{
                label: '语言分布',
                data: Object.values({{ exercise_metrics.language_distribution|tojson }}),
                backgroundColor: [
                    'rgba(255, 99, 132, 0.5)',
                    'rgba(54, 162, 235, 0.5)',
                    'rgba(255, 206, 86, 0.5)',
                    'rgba(75, 192, 192, 0.5)'
                ],
                borderColor: [
                    'rgba(255, 99, 132, 1)',
                    'rgba(54, 162, 235, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(75, 192, 192, 1)'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                title: {
                    display: true,
                    text: '编程语言使用分布'
                }
            }
        }
    });
});

// 下载报告功能
function downloadReport() {
    // 创建报告内容
    const reportContent = `
        <!DOCTYPE html>
        <html>
        <head>
            <title>学习建议报告 - {{ student.name }}</title>
            <style>
                body { font-family: Arial, sans-serif; margin: 20px; }
                .header { text-align: center; margin-bottom: 30px; }
                .report-title { font-size: 24px; font-weight: bold; }
                .student-info { margin: 10px 0; }
                .section { margin-bottom: 20px; }
                .section-title { font-size: 18px; font-weight: bold; border-bottom: 1px solid #ccc; padding-bottom: 5px; margin-bottom: 10px; }
                .metric-card { border: 1px solid #ddd; padding: 10px; margin: 10px 0; border-radius: 5px; }
                .chart-container { margin: 20px 0; }
            </style>
        </head>
        <body>
            <div class="header">
                <div class="report-title">个性化学习建议报告</div>
                <div class="student-info">学生: {{ student.name }} | {{ student.employee_id }}</div>
                <div class="student-info">课程: {{ student.course }} | 级别: {{ student.level }}</div>
                <div class="student-info">报告日期: {{ report_date }}</div>
            </div>
            
            <div id="report-content">
                ${document.getElementById('suggestion-content').innerHTML}
            </div>
        </body>
        </html>
    `;
    
    // 创建Blob对象
    const blob = new Blob([reportContent], {type: 'text/html'});
    
    // 创建下载链接
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = '学习建议报告_{{ student.name }}_{{ report_date }}.html';
    
    // 触发下载
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}
</script>

<style>
/* 自定义样式 */
.report-header {
    background: linear-gradient(135deg, #e3f2fd, #f8f9fa);
    padding: 20px;
    border-radius: 10px;
    border: 1px solid #dee2e6;
}

.metric-card {
    background: #f8f9fa;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    transition: all 0.3s;
}

.metric-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 10px rgba(0,0,0,0.1);
}

.metric-value {
    font-weight: 700;
    color: #4e73df;
}

.metric-label {
    font-size: 0.9rem;
    color: #6c757d;
    margin: 5px 0;
}

.metric-trend {
    font-size: 0.85rem;
}

.status-summary {
    border-left: 4px solid #4e73df;
}

.chart-container {
    position: relative;
    height: 300px;
    margin-top: 20px;
}

/* 学习建议内容样式 */
#suggestion-content h3 {
    border-bottom: 2px solid #4e73df;
    padding-bottom: 5px;
    margin-top: 25px;
    color: #2e59d9;
}

#suggestion-content ul {
    padding-left: 20px;
}

#suggestion-content li {
    margin-bottom: 8px;
}

#suggestion-content strong {
    color: #2e59d9;
}

.bg-purple {
    background-color: #6f42c1;
}
</style>
{% endblock %}

