{% extends "base.html" %}

{% block title %}我的成绩 - 编程学习系统{% endblock %}

{% block head %}
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
    /* 所有CSS样式保持不变 */
    :root {
        --primary: #4361ee;
        --secondary: #3f37c9;
        --success: #4cc9f0;
        --warning: #f72585;
        --light: #f8f9fa;
        --dark: #212529;
        --gray: #6c757d;
        --light-gray: #e9ecef;
        --border-radius: 12px;
        --box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        --transition: all 0.3s ease;
    }
    
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Noto Sans SC', sans-serif;
    }
    
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e4edf5 100%);
        color: var(--dark);
        min-height: 100vh;
        padding: 20px;
    }
    
    .container {
        max-width: 1200px;
        margin: 0 auto;
    }
    
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 0;
        margin-bottom: 30px;
        border-bottom: 1px solid var(--light-gray);
    }
    
    .logo {
        display: flex;
        align-items: center;
        gap: 15px;
    }
    
    .logo-icon {
        background: var(--primary);
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
        box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
    }
    
    .logo-text h1 {
        font-size: 28px;
        font-weight: 700;
        color: var(--primary);
    }
    
    .logo-text p {
        font-size: 14px;
        color: var(--gray);
    }
    
    .user-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }
    
    .user-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(45deg, var(--primary), var(--success));
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 22px;
        font-weight: bold;
    }
    
    .user-details h3 {
        font-weight: 600;
        margin-bottom: 5px;
    }
    
    .user-details p {
        color: var(--gray);
        font-size: 14px;
    }
    
    .page-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }
    
    .page-title h2 {
        font-size: 32px;
        font-weight: 700;
        color: var(--dark);
        display: flex;
        align-items: center;
        gap: 15px;
    }
    
    .page-title h2 i {
        background: var(--primary);
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }
    
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }
    
    .stat-card {
        background: white;
        border-radius: var(--border-radius);
        padding: 25px;
        box-shadow: var(--box-shadow);
        transition: var(--transition);
        display: flex;
        flex-direction: column;
    }
    
    .stat-card:hover {
        transform: translateY(-5px);
    }
    
    .stat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    
    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }
    
    .icon-1 { background: rgba(67, 97, 238, 0.15); color: var(--primary); }
    .icon-2 { background: rgba(76, 201, 240, 0.15); color: var(--success); }
    .icon-3 { background: rgba(247, 37, 133, 0.15); color: var(--warning); }
    
    .stat-value {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 5px;
    }
    
    .stat-label {
        font-size: 16px;
        color: var(--gray);
    }
    
    .main-content {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 25px;
    }
    
    .grades-section, .analysis-section {
        background: white;
        border-radius: var(--border-radius);
        padding: 25px;
        box-shadow: var(--box-shadow);
        margin-bottom: 30px;
    }
    
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--light-gray);
    }
    
    .section-header h3 {
        font-size: 22px;
        font-weight: 600;
        color: var(--dark);
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .controls {
        display: flex;
        gap: 15px;
    }
    
    .btn {
        padding: 10px 20px;
        border-radius: 8px;
        border: none;
        font-weight: 500;
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .btn-primary {
        background: var(--primary);
        color: white;
    }
    
    .btn-outline {
        background: transparent;
        border: 1px solid var(--primary);
        color: var(--primary);
    }
    
    .btn:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }
    
    table {
        width: 100%;
        border-collapse: collapse;
    }
    
    th, td {
        padding: 16px 15px;
        text-align: left;
        border-bottom: 1px solid var(--light-gray);
    }
    
    th {
        font-weight: 600;
        color: var(--gray);
        font-size: 14px;
        cursor: pointer;
    }
    
    th:hover {
        color: var(--primary);
    }
    
    th i {
        margin-left: 5px;
        font-size: 12px;
    }
    
    tr:last-child td {
        border-bottom: none;
    }
    
    tr:hover {
        background-color: rgba(67, 97, 238, 0.03);
    }
    
    .topic-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .topic-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        background: rgba(67, 97, 238, 0.1);
        color: var(--primary);
    }
    
    .topic-info h4 {
        font-weight: 600;
        margin-bottom: 4px;
    }
    
    .topic-info p {
        font-size: 13px;
        color: var(--gray);
    }
    
    .score-cell .score-value {
        font-weight: 700;
        font-size: 18px;
    }
    
    .score-cell .max-score {
        color: var(--gray);
        font-size: 14px;
    }
    
    .progress-cell {
        width: 30%;
    }
    
    .progress-container {
        height: 8px;
        background: var(--light-gray);
        border-radius: 4px;
        overflow: hidden;
    }
    
    .progress-bar {
        height: 100%;
        border-radius: 4px;
    }
    
    .status-cell .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        display: inline-block;
    }
    
    .status-pending {
        background: rgba(255, 193, 7, 0.15);
        color: #ff9800;
    }
    
    .status-reviewed {
        background: rgba(76, 175, 80, 0.15);
        color: #4caf50;
    }
    
    .action-cell .btn-action {
        padding: 8px 15px;
        border-radius: 8px;
        background: rgba(67, 97, 238, 0.1);
        color: var(--primary);
        border: none;
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 5px;
    }
    
    .btn-action:hover {
        background: var(--primary);
        color: white;
    }
    
    .chart-container {
        height: 250px;
        margin-top: 20px;
    }
    
    .difficulty-distribution {
        margin-top: 25px;
    }
    
    .difficulty-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid var(--light-gray);
    }
    
    .difficulty-item:last-child {
        border-bottom: none;
    }
    
    .difficulty-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .difficulty-stars {
        color: #ffc107;
        font-size: 18px;
    }
    
    .difficulty-label {
        font-weight: 500;
    }
    
    .difficulty-count {
        font-weight: 600;
        color: var(--primary);
    }
    
    footer {
        text-align: center;
        padding: 30px 0;
        color: var(--gray);
        font-size: 14px;
        margin-top: 30px;
        border-top: 1px solid var(--light-gray);
    }
    
    /* 新增筛选相关样式 */
    .filters {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }
    
    .filter-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .filter-label {
        color: var(--gray);
        font-size: 14px;
    }
    
    .filter-select, .search-input {
        padding: 10px 15px;
        border-radius: 8px;
        border: 1px solid var(--light-gray);
        background: white;
        font-size: 14px;
        transition: var(--transition);
    }
    
    .filter-select:focus, .search-input:focus {
        border-color: var(--primary);
        outline: none;
        box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
    }
    
    .search-input {
        min-width: 200px;
    }
    
    .no-results {
        text-align: center;
        padding: 40px 20px;
        color: var(--gray);
        display: none;
    }
    
    .no-results i {
        font-size: 48px;
        margin-bottom: 15px;
        color: var(--light-gray);
    }
    
    /* 响应式设计 */
    @media (max-width: 992px) {
        .main-content {
            grid-template-columns: 1fr;
        }
        
        .stats-cards {
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        }
    }
    
    @media (max-width: 768px) {
        header {
            flex-direction: column;
            gap: 20px;
        }
        
        .page-title {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }
        
        .controls {
            width: 100%;
            justify-content: space-between;
        }
        
        .btn {
            flex: 1;
            justify-content: center;
        }
        
        table {
            display: block;
            overflow-x: auto;
        }
        
        .filters {
            flex-direction: column;
            gap: 10px;
        }
        
        .filter-group {
            width: 100%;
        }
        
        .filter-select, .search-input {
            width: 100%;
        }
    }
    
    /* 确保canvas可见性 */
    canvas {
        display: block !important;
    }
</style>
{% endblock %}

{% block content %}
<div class="container">
    <header>
        <div class="logo">
            <div class="logo-icon">
                <i class="fas fa-laptop-code"></i>
            </div>
        </div>
    </header>

    <div class="page-title">
        <h2><i class="fas fa-chart-line"></i> 我的考试成绩</h2>
        <div class="controls">
            <button class="btn btn-outline">
                <i class="fas fa-download"></i> 导出成绩
            </button>
            <button class="btn btn-primary" id="refresh-btn">
                <i class="fas fa-sync-alt"></i> 刷新数据
            </button>
        </div>
    </div>

    <div class="stats-cards">
        <div class="stat-card">
            <div class="stat-header">
                <div>
                    <div class="stat-value">{{average_score}}</div>
                    <div class="stat-label">平均分</div>
                </div>
                <div class="stat-icon icon-1">
                    <i class="fas fa-star"></i>
                </div>
            </div>
            <div class="stat-trend">最近一次 {{latest_exam.ai_score}} 分</div>
        </div>
        
        <div class="stat-card">
            <div class="stat-header">
                <div>
                    <div class="stat-value">{{exam_count}}</div>
                    <div class="stat-label">考试次数</div>
                </div>
                <div class="stat-icon icon-2">
                    <i class="fas fa-clipboard-list"></i>
                </div>
            </div>
            <div class="stat-trend">本月已完成 {{this_month_exam_count}} 次考试</div>
        </div>
        
        <div class="stat-card">
            <div class="stat-header">
                <div>
                    <div class="stat-value">{{excellent_rate}}%</div>
                    <div class="stat-label">优秀率</div>
                </div>
                <div class="stat-icon icon-3">
                    <i class="fas fa-tasks"></i>
                </div>
            </div>
            <div class="stat-trend">优秀通过 {{excellent_count}}/{{exam_count}} 次考试</div>
        </div>
    </div>

    
    <div class="main-content">

        <!-- 右侧：分析部分 -->
        <div class="analysis-section">
            <div class="section-header">
                <h3><i class="fas fa-chart-pie"></i> 成绩分析</h3>
            </div>
            
            <h4>成绩趋势图</h4>
            <div class="chart-container">
                <canvas id="scoreTrendChart"></canvas>
            </div>
            
            <div class="difficulty-distribution">
                <h4>难度分布</h4>
                <div class="difficulty-item">
                    <div class="difficulty-info">
                        <div class="difficulty-stars">★★★</div>
                        <div class="difficulty-label">困难</div>
                    </div>
                    <div class="difficulty-count">{{difficulty_count[3]}} 次</div>
                </div>
                <div class="difficulty-item">
                    <div class="difficulty-info">
                        <div class="difficulty-stars">★★☆</div>
                        <div class="difficulty-label">中等</div>
                    </div>
                    <div class="difficulty-count">{{difficulty_count[2]}} 次</div>
                </div>
                <div class="difficulty-item">
                    <div class="difficulty-info">
                        <div class="difficulty-stars">★☆☆</div>
                        <div class="difficulty-label">简单</div>
                    </div>
                    <div class="difficulty-count">{{difficulty_count[1]}} 次</div>
                </div>
            </div>
        </div>

        <!-- 左侧：成绩记录部分 -->
        <div class="grades-section">
            <div class="section-header">
                <h3><i class="fas fa-list"></i> 考试成绩记录</h3>
            </div>
            
            <!-- 添加筛选区域 -->
            <div class="filters">
                <div class="filter-group">
                    <span class="filter-label">科目筛选:</span>
                    <select class="filter-select" id="topic-filter">
                        <option value="all">所有科目</option>
                        {% for topic in exam_topics %}
                        <option value="{{ topic }}">{{ topic }}</option>
                        {% endfor %}
                    </select>
                </div>
                
                <div class="filter-group">
                    <span class="filter-label">搜索考试:</span>
                    <input type="text" class="search-input" id="search-exam" placeholder="输入考试名称...">
                </div>
            </div>
            
            <table>
                <thead>
                    <tr>
                        <th>考试科目 <i class="fas fa-sort"></i></th>
                        <th>日期 <i class="fas fa-sort"></i></th>
                        <th>得分</th>
                        <th>掌握程度</th>
                        <th>状态</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody id="grades-table-body">
                    {% for record in records %}
                    <tr class="exam-row" data-topic="{{ record.topic }}">
                        <td>
                            <div class="topic-cell">
                                <div class="topic-icon">
                                    <i class="fas {{ record.icon }}"></i>
                                </div>
                                <div class="topic-info">
                                    <h4>{{ record.topic }}</h4>
                                    <p>难度: {{ record.difficulty }}</p>
                                </div>
                            </div>
                        </td>
                        <td>{{ record.submitted_at.strftime('%Y-%m-%d') }}</td>
                        <td class="score-cell">
                            <div class="score-value">{{ record.ai_score }}</div>
                            <div class="max-score">/100</div>
                        </td>
                        <td class="progress-cell">
                            <div class="progress-container">
                                {% set progress_color = "#4caf50" if record.ai_score >= 80 else "#ff9800" %}
                                <div class="progress-bar" 
                                     style="width: {{ record.ai_score }}%; background: {{ progress_color }};"></div>
                            </div>
                        </td>
                        <td class="status-cell">
                            {% if record.is_reviewed %}
                            <span class="status-badge status-reviewed">已批改</span>
                            {% else %}
                            <span class="status-badge status-pending">待批改</span>
                            {% endif %}
                        </td>
                        <td class="action-cell">
                            <a href="/student/exam_detail/{{ record.id }}" class="btn-action">
                                <i class="fas fa-eye"></i> 查看
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            
            <!-- 添加空状态提示 -->
            <div class="no-results" id="no-results-message">
                <i class="fas fa-search"></i>
                <h3>没有找到匹配的考试记录</h3>
                <p>请尝试其他筛选条件或搜索关键词</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const initChart = function() {
            const ctx = document.getElementById('scoreTrendChart');
            if (ctx) {
                console.log("初始化成绩趋势图...");
                try {
                    const scoreTrendChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: [0,1,2,3],
                            datasets: [{
                                label: '历次考试分(ai_score)',
                                data: [0,1,2,3],
                                borderColor: '#4361ee',
                                backgroundColor: 'rgba(67, 97, 238, 0.1)',
                                tension: 0.3,
                                fill: true,
                                pointBackgroundColor: '#4361ee',
                                pointRadius: 5
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false
                                }
                            },
                            scales: {
                                y: {
                                    min: 0,
                                    max: 100,
                                    grid: {
                                        color: 'rgba(0, 0, 0, 0.05)'
                                    }
                                },
                                x: {
                                    grid: {
                                        display: false
                                    }
                                }
                            }
                        }
                    });
                    console.log("成绩趋势图初始化成功");
                } catch (e) {
                    console.error("图表初始化失败:", e);
                }
            } else {
                console.error('无法找到成绩趋势图画布元素');
            }
        };

        // 修复4：重新设计筛选功能
        const initFilters = function() {
            const topicFilter = document.getElementById('topic-filter');
            const searchInput = document.getElementById('search-exam');
            const examRows = document.querySelectorAll('.exam-row');
            const noResults = document.getElementById('no-results-message');
            const refreshBtn = document.getElementById('refresh-btn');
            
            if (!topicFilter || !searchInput || !examRows || examRows.length === 0 || !noResults || !refreshBtn) {
                console.error("筛选功能初始化失败：缺少必要元素");
                return;
            }
            
            // 筛选函数
            function filterExams() {
                const selectedTopic = topicFilter.value;
                const searchTerm = searchInput.value.toLowerCase();
                let visibleCount = 0;
                
                examRows.forEach(row => {
                    const topic = row.getAttribute('data-topic');
                    const topicText = row.querySelector('.topic-info h4').textContent.toLowerCase();
                    
                    // 检查主题筛选
                    const topicMatch = selectedTopic === 'all' || topic === selectedTopic;
                    
                    // 检查搜索关键词
                    const searchMatch = searchTerm === '' || topicText.includes(searchTerm);
                    
                    if (topicMatch && searchMatch) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });
                
                // 显示/隐藏空状态提示
                noResults.style.display = visibleCount === 0 ? 'block' : 'none';
                console.log(`筛选完成：显示 ${visibleCount} 条记录`);
            }
            
            // 添加事件监听器
            topicFilter.addEventListener('change', filterExams);
            searchInput.addEventListener('input', filterExams);
            
            // 刷新按钮
            refreshBtn.addEventListener('click', function() {
                console.log("刷新数据...");
                window.location.reload();
            });
            
            // 初始化筛选状态
            filterExams();
            console.log("筛选功能初始化完成");
        };

        // 修复5：表格排序功能
        const initTableSorting = function() {
            document.querySelectorAll('th').forEach(header => {
                header.addEventListener('click', () => {
                    const table = header.closest('table');
                    if (!table) return;
                    
                    const tbody = table.querySelector('tbody');
                    const rows = Array.from(tbody.querySelectorAll('tr:not([style*="display: none"])'));
                    
                    // 如果没有可见行，则跳过排序
                    if (rows.length === 0) return;
                    
                    const columnIndex = Array.from(header.parentNode.children).indexOf(header);
                    
                    rows.sort((a, b) => {
                        const aValue = a.children[columnIndex].textContent.trim();
                        const bValue = b.children[columnIndex].textContent.trim();
                        
                        // 处理分数排序
                        if (columnIndex === 2) {
                            return parseInt(aValue) - parseInt(bValue);
                        }
                        
                        // 默认按文本排序
                        return aValue.localeCompare(bValue);
                    });
                    
                    // 反转排序顺序
                    if (header.classList.contains('sorted-asc')) {
                        rows.reverse();
                        header.classList.remove('sorted-asc');
                        header.classList.add('sorted-desc');
                    } else {
                        header.classList.remove('sorted-desc');
                        header.classList.add('sorted-asc');
                    }
                    
                    // 重新添加行
                    rows.forEach(row => tbody.appendChild(row));
                    console.log(`按第${columnIndex+1}列排序完成`);
                });
            });
        };

        // 修复6：查看详情按钮事件
        const initViewButtons = function() {
            document.querySelectorAll('.btn-action').forEach(button => {
                button.addEventListener('click', (e) => {
                    e.preventDefault();
                    const examId = button.closest('a').getAttribute('href').split('/').pop();
                    console.log(`查看考试详情: ${examId}`);
                    window.location.href = `/student/exam_detail/${examId}`;
                });
            });
        };

        // 初始化所有功能
        console.log("开始初始化页面功能...");
        initChart();
        initFilters();
        initTableSorting();
        initViewButtons();
        console.log("页面功能初始化完成");
    });
</script>
{% endblock %}
