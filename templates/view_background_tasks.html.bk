{% extends "base.html" %}

{% block title %}后台任务管理{% endblock %}

{% block content %}
<div class="tasks-container">
    <div class="tasks-header">
        <h2>后台任务管理</h2>
        <div class="header-actions">
            <a href="{{ url_for('teacher_generate_questions') }}" class="btn primary">
                <span>+</span> 创建新任务
            </a>
        </div>
    </div>

    <!-- 任务筛选和搜索 -->
    <div class="tasks-filters">
        <form method="GET" class="filter-form">
            <div class="form-group">
                <label for="status">状态筛选:</label>
                <select id="status" name="status" onchange="this.form.submit()">
                    <option value="all" {% if status == 'all' %}selected{% endif %}>全部状态</option>
                    <option value="pending" {% if status == 'pending' %}selected{% endif %}>等待中</option>
                    <option value="processing" {% if status == 'processing' %}selected{% endif %}>进行中</option>
                    <option value="completed" {% if status == 'completed' %}selected{% endif %}>已完成</option>
                    <option value="failed" {% if status == 'failed' %}selected{% endif %}>已失败</option>
                </select>
            </div>
            
            <div class="form-group">
                <label for="task_type">任务类型:</label>
                <select id="task_type" name="task_type" onchange="this.form.submit()">
                    <option value="all" {% if task_type == 'all' %}selected{% endif %}>全部类型</option>
                    <option value="generate_questions" {% if task_type == 'generate_questions' %}selected{% endif %}>生成题目</option>
                    <option value="auto_grade" {% if task_type == 'auto_grade' %}selected{% endif %}>自动评分</option>
                    <option value="suggestion" {% if task_type == 'suggestion' %}selected{% endif %}>学习建议</option>
                </select>
            </div>
        </form>
        
        <form method="GET" class="search-form">
            <input type="text" name="search" placeholder="搜索任务..." value="{{ search or '' }}">
            <button type="submit">搜索</button>
        </form>
    </div>

    <!-- 任务列表 -->
    <div class="tasks-list">
        {% if not tasks %}
        <div class="empty-state">
            <p>没有找到符合条件的任务</p>
            <a href="{{ url_for('view_background_tasks') }}" class="btn">查看所有任务</a>
        </div>
        {% else %}
        <table class="tasks-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>类型</th>
                    <th>状态</th>
                    <th>进度</th>
                    <th>创建时间</th>
                    <th>更新时间</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                {% for task in tasks %}
                <tr>
                    <td>{{ task.id }}</td>
                    <td>{{ task.task_type }}</td>
                    <td>
                        <span class="badge 
                           {% if task.status == 'completed' %}bg-success
                           {% elif task.status == 'failed' %}bg-danger
                           {% elif task.status == 'processing' %}bg-warning
                           {% else %}bg-secondary{% endif %}">
                           {{ task.status }}
                        </span>
                    </td>
                    <td>
                        {% if task.status == 'processing' %}
                        <div class="progress">
                           <div class="progress-bar" role="progressbar" 
                                style="width: {{ (task.progress / task.total * 100) | round(1) }}%;"
                                aria-valuenow="{{ task.progress }}" 
                                aria-valuemin="0" 
                                aria-valuemax="{{ task.total }}">
                                {{ task.progress }}/{{ task.total }}
                           </div>
                        </div>
                        {% elif task.status == 'completed' %}
                            完成: {{ task.progress }}/{{ task.total }}
                        {% else %}
                             -
                        {% endif %}
                    </td>
                    <td>{{ task.created_at.strftime('%Y-%m-%d %H:%M') if task.created_at else '-' }}</td>
                    <td>{{ task.updated_at.strftime('%Y-%m-%d %H:%M') if task.updated_at else '-' }}</td>
                    <td>
                        <a href="{{ url_for('task_detail', task_id=task.id) }}" 
                           class="btn btn-sm btn-info">
                           <i class="fas fa-info-circle"></i> 详情
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        
        <!-- 分页控制 -->
        {% set total_pages = total_pages or 1 %}
        {% set page = page or 1 %}
        <div class="pagination">
            {% if page > 1 %}
            <a href="?page=1&status={{ status }}&task_type={{ task_type }}&search={{ search }}" class="btn">« 第一页</a>
            <a href="?page={{ page-1 }}&status={{ status }}&task_type={{ task_type }}&search={{ search }}" class="btn">‹ 上一页</a>
            {% endif %}
            
            <span class="current-page">第 {{ page }} 页 / 共 {{ total_pages }} 页</span>
            
            {% if page < total_pages %}
            <a href="?page={{ page+1 }}&status={{ status }}&task_type={{ task_type }}&search={{ search }}" class="btn">下一页 ›</a>
            <a href="?page={{ total_pages }}&status={{ status }}&task_type={{ task_type }}&search={{ search }}" class="btn">最后一页 »</a>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    // 重新运行任务的按钮处理
    document.querySelectorAll('.restart-btn').forEach(button => {
        button.addEventListener('click', async function() {
            const taskId = this.dataset.taskId;
            
            try {
                // 显示加载指示器
                this.innerHTML = '<span class="spinner"></span> 处理中...';
                this.disabled = true;
                
                // 发送API请求重新运行任务
                const response = await fetch(`/api/tasks/${taskId}/restart`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                const result = await response.json();
                
                if (response.ok && result.success) {
                    alert('任务已成功重新启动！');
                    // 刷新页面
                    location.reload();
                } else {
                    alert(`重新启动任务失败: ${result.message || '未知错误'}`);
                    // 恢复按钮状态
                    this.innerHTML = '重新运行';
                    this.disabled = false;
                }
            } catch (error) {
                alert('网络错误，请重试');
                console.error('重新运行任务失败:', error);
                // 恢复按钮状态
                this.innerHTML = '重新运行';
                this.disabled = false;
            }
        });
    });
    
    // 状态筛选器变化时自动提交表单
    document.getElementById('status').addEventListener('change', function() {
        this.form.submit();
    });
    
    document.getElementById('task_type').addEventListener('change', function() {
        this.form.submit();
    });
</script>
{% endblock %}
