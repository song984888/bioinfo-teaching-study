{% extends "base.html" %}

{% block title %}AI出题{% endblock %}

{% block content %}
<div class="generate-questions">
    <h2>AI出题</h2>
    <form method="POST">
        <div class="form-group">
            <label for="topic">主题</label>
            <select id="topic" name="topic" required>
                {% for topic in topicList %}
                   <option value="{{topic}}">{{topic}}</option>
                {% endfor %}
            </select>
        </div>
        
        <div class="form-group">
            <label for="difficulty">难度 (1-3)</label>
            <input type="number" id="difficulty" name="difficulty" min="1" max="3" value="2" required>
        </div>
        
        <div class="form-group">
            <label for="language">编程语言</label>
            <select id="language" name="language" required>
                <option value="python">Python</option>
                <option value="java">Java</option>
                <option value="c">C</option>
                <option value="perl">Perl</option>
            </select>
        </div>
        
        <div class="form-group">
            <label for="count">生成数量</label>
            <input type="number" id="count" name="count" min="1" max="20" value="5" required>
        </div>
        
        <div class="form-group">
            <label for="ai_model">AI模型</label>
            <select id="ai_model" name="ai_model" required>
                <option value="qwen2.5-coder:32b">Qwen Coder</option>
                <option value="deepseek-r1:7b">DeepSeek R1</option>
                <option value="deepseek-coder:33b">DeepSeek Coder</option>
                <option value="codellama:7b">CodeLlama</option>
                <option value="deepseek_API">DeepSeek API</option>
            </select>
        </div>
        
        <button type="submit" class="btn primary">生成题目</button>
    </form>
</div>
{% endblock %}
