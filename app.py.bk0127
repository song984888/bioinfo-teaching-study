    # 获取完整考试记录
    cursor.execute("""
        SELECT e.*, q.question_text, q.sample_answer, q.hints, q.topic, q.difficulty
        FROM exams_mock e
        JOIN questions_mock q ON e.question_id = q.id
        WHERE e.id = %s
    """, (cursor.lastrowid,))
