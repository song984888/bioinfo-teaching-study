        cursor = conn.cursor(dictionary=True)
        
        cursor.execute("""
            SELECT e.*, q.question_text
            FROM exams e
            JOIN questions q ON e.question_id = q.id
            WHERE e.id = %s
        """, (exam_id,))
        
        exam = cursor.fetchone()
